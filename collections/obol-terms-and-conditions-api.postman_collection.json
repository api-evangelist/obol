          "name": "Verify Signature on Terms and Conditions",
          "request": {
            "name": "Verify Signature on Terms and Conditions",
            "description": {
              "content": "This endpoint is used to check whether the Terms and Conditions has been signed by the user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "termsAndConditions",
                ":address"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "address",
                  "description": "(Required) The address to check the Terms and Conditions."
                }
              ]
            },
            "header": [
