          "name": "Saves user's approval latest terms and conditions",
          "request": {
            "name": "Saves user's approval latest terms and conditions",
            "description": {
              "content": "Saves user's signature to latest [Obol's terms and conditions](https://obol.tech/terms.pdf) hash and it's version",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "termsAndConditions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"<string>\",\n  \"version\": \"<number>\",\n  \"terms_and_conditions_hash\": \"<string>\",\n  \"fork_version\": \"<string>\"\n}",
