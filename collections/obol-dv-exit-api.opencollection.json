            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.obol.tech/exp/exit/status/summary/:lockHash",
            "params": [
              {
                "name": "lockHash",
                "value": "",
                "type": "path",
                "description": "The cluster lock hash."
              }
            ]
          },
          "docs": "It shows data of operators who have signed and the count of validators ready to exit"
        },
