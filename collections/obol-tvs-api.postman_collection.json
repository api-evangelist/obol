          "name": "Get Total Value Staked Of Obol for a network",
          "request": {
            "name": "Get Total Value Staked Of Obol for a network",
            "description": {
              "content": "Returns either summary (total balance) or detailed (validator-level) TVS data for a specific timestamp. All returned data (balances, counts, totals) corresponds to the timestamp shown in the response. Each network has one data snapshot per day.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tvs",
                ":network"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of results per page (only applies when details=true)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Page number (only applies when details=true)"
                },
                {
                  "disabled": false,
                  "key": "details",
                  "value": "false",
                  "description": "If true, returns detailed validator-level data"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "network",
                  "description": "(Required) Network name (e.g., mainnet, hoodi)"
                }
              ]
