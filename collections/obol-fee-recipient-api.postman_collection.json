        {
          "id": "1c1a5c2e-8452-452e-b38b-29489b101ba6",
          "name": "Fetch partial fee recipient registrations",
          "request": {
            "name": "Fetch partial fee recipient registrations",
            "description": {
              "content": "Returns builder registration status for validators in a cluster. For each validator, returns at most two registrations: the latest one that reached quorum (quorum: true) and the latest one still collecting signatures (quorum: false). Validators with no registration data are omitted. Optionally pass an array of pubkeys in the request body to filter results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fee_recipient",
                ":lockHash"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lockHash",
                  "description": "(Required) The cluster lock hash."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pubkeys\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e637092d-dc33-4099-89b3-a8376092e707",
              "name": "Per validator: at most 2 builder registrations (latest with quorum: true, latest with quorum: false). Each registration includes the signed message, partial signatures, and a quorum boolean. Pubkeys returned without 0x prefix.",
              "originalRequest": {
                "url": {
                  "path": [
                    "fee_recipient",
                    ":lockHash"
                  ],
