        {
          "id": "002b6034-ea35-4538-a32b-de28c6e30ed6",
          "name": "Submit partial fee recipient registrations",
          "request": {
            "name": "Submit partial fee recipient registrations",
            "description": {
              "content": "Stores partial BLS-signed builder registration messages for a given cluster operator. Partials are grouped into builder registrations by message content (fee_recipient, gas_limit, timestamp). The timestamp must be greater than or equal to the highest timestamp any operator has submitted for each pubkey. Equal timestamps are allowed so operators can join an existing registration group.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fee_recipient",
                "partial",
                ":lockHash",
                ":shareIdx"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lockHash",
                  "description": "(Required) The cluster lock hash."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<number>",
                  "key": "shareIdx",
                  "description": "(Required) The operator share index (1-based)."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partial_registrations\": [\n    {\n      \"message\": {\n        \"fee_recipient\": \"<string>\",\n        \"gas_limit\": \"<string>\",\n        \"timestamp\": \"<string>\",\n        \"pubkey\": \"<string>\"\n      },\n      \"signature\": \"<string>\"\n    }\n  ]\n}",
              "options": {
