          "id": "ee1d0a46-f475-4bae-8821-7fecec31f1d6",
          "name": "Store test result data",
          "request": {
            "name": "Store test result data",
            "description": {
              "content": "Accepts the JSON body produced by Charon when running `charon test … --publish`: **`enr`**, **`sig`**, and **`data`**. Authentication is **not** a Bearer token: `TestEnrGuard` verifies that `sig` is a valid secp256k1 ECDSA signature (base64, as emitted by Go `json.Marshal` on the signature bytes) over the SSZ hash of `JSON.stringify(data)` for the public key embedded in `enr`. Only `Content-Type: application/json` is required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "test"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"charon_peers\": {\n      \"category_name\": \"<string>\",\n      \"execution_time\": \"<string>\",\n      \"score\": \"<string>\",\n      \"targets\": \"<object>\"\n    },\n    \"beacon_node\": {\n      \"category_name\": \"<string>\",\n      \"execution_time\": \"<string>\",\n      \"score\": \"<string>\",\n      \"targets\": \"<object>\"\n    },\n    \"validator_client\": {\n      \"category_name\": \"<string>\",\n      \"execution_time\": \"<string>\",\n      \"score\": \"<string>\",\n      \"targets\": \"<object>\"\n    },\n    \"mev\": {\n      \"category_name\": \"<string>\",\n      \"execution_time\": \"<string>\",\n      \"score\": \"<string>\",\n      \"targets\": \"<object>\"\n    },\n    \"infra\": {\n      \"category_name\": \"<string>\",\n      \"execution_time\": \"<string>\",\n      \"score\": \"<string>\",\n      \"targets\": \"<object>\"\n    }\n  },\n  \"enr\": \"<string>\",\n  \"sig\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
